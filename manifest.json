{
  "manifest_version": 2,
  "name": "PeelScout",
  "description": "Removes the first email-security URL wrapper, shows nested EML content and QR URLs, previews PDF attachments and lists QR codes and links inside them, and surfaces calendar-invite URLs.",
  "version": "1.8.1",
  "author": "ExploitBlock",
  "browser_specific_settings": {
    "gecko": {
      "id": "peelscout@exploitblock.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["messagesRead", "messagesModify", "menus", "clipboardWrite"],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "background": {
    "scripts": ["ics.js", "nested.js", "jsqr.min.js", "pdfscan.js", "background.js"]
  },
  "message_display_action": {
    "default_title": "PeelScout",
    "default_popup": "popup.html"
  }
}
